<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/fintech.css"
            fx:controller="co.edu.uniquindio.proyectofinal.Presentacion.ViewControllers.UserViewController"
            styleClass="app-page">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar, topbar-user">
            <VBox spacing="2">
                <Label text="NEXO" styleClass="brand-small"/>
                <Label text="MI BILLETERA" styleClass="eyebrow"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="lblNombreUsuario" text="Hola" styleClass="topbar-name"/>
                <Label fx:id="lblIdentificacion" text="" styleClass="topbar-sub"/>
            </VBox>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="ghost-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" styleClass="page-content">

            <!-- Resumen -->
            <HBox spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="5" styleClass="balance-card" HBox.hgrow="ALWAYS">
                    <Label text="SALDO EN TUS BILLETERAS ACTIVAS" styleClass="eyebrow-light"/>
                    <Label fx:id="lblSaldoTotal" text="\$ 0" styleClass="balance-value"/>
                    <Label text="Tu dinero organizado en un solo lugar" styleClass="balance-caption"/>
                </VBox>
                <VBox spacing="6" styleClass="metric-card, accent-amber" prefWidth="200" minWidth="170">
                    <Label text="PUNTOS" styleClass="eyebrow"/>
                    <Label fx:id="lblPuntos" text="0" styleClass="metric-value"/>
                    <Label text="Recompensas acumuladas" styleClass="muted-label"/>
                </VBox>
                <VBox spacing="6" styleClass="metric-card, accent-teal" prefWidth="200" minWidth="170">
                    <Label text="NIVEL" styleClass="eyebrow"/>
                    <Label fx:id="lblNivel" text="Bronce" styleClass="metric-value"/>
                    <Label text="Según tus puntos" styleClass="muted-label"/>
                </VBox>
            </HBox>

            <TabPane fx:id="tabsUsuario" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="main-tabs">
                <tabs>

                    <!-- 1. Billeteras -->
                    <Tab text="Mis billeteras">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Tus espacios de dinero" styleClass="page-title"/>
                                <Label text="Cada billetera tiene su propio saldo e historial. Las nuevas inician con $0."
                                       styleClass="muted-label"/>
                            </VBox>
                            <VBox spacing="8" styleClass="surface-card">
                                <Label text="Crear una billetera" styleClass="section-title"/>
                                <FlowPane hgap="10" vgap="10" styleClass="form-row">
                                    <TextField fx:id="txtNuevaWalletCodigo" promptText="Código numérico (único)" prefWidth="190"/>
                                    <TextField fx:id="txtNuevaWalletNombre" promptText="Nombre" prefWidth="220"/>
                                    <ChoiceBox fx:id="cmbNuevaWalletTipo" prefWidth="180"/>
                                    <Button text="Crear billetera" onAction="#crearBilletera" styleClass="primary-button"/>
                                </FlowPane>
                            </VBox>
                            <TableView fx:id="tablaBilleteras" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <placeholder><Label text="Aún no tienes billeteras. Crea la primera arriba." styleClass="muted-label"/></placeholder>
                                <columns>
                                    <TableColumn fx:id="colWalletCodigo" text="Código"/>
                                    <TableColumn fx:id="colWalletNombre" text="Nombre"/>
                                    <TableColumn fx:id="colWalletTipo" text="Categoría"/>
                                    <TableColumn fx:id="colWalletSaldo" text="Saldo disponible"/>
                                    <TableColumn fx:id="colWalletEstado" text="Estado"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- 2. Mover dinero -->
                    <Tab text="Mover dinero">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Mover dinero" styleClass="page-title"/>
                                <Label text="Recarga, retira o transfiere a cualquier billetera de la plataforma."
                                       styleClass="muted-label"/>
                            </VBox>
                            <VBox spacing="14" styleClass="surface-card" maxWidth="760">
                                <VBox spacing="5">
                                    <Label text="Billetera de origen" styleClass="field-label"/>
                                    <ComboBox fx:id="cmbOrigen" promptText="Elige tu billetera" prefWidth="420"/>
                                </VBox>
                                <HBox spacing="12">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Monto (pesos enteros)" styleClass="field-label"/>
                                        <TextField fx:id="txtMonto" promptText="Ej. 50000"/>
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Código de billetera destino (solo transferir)" styleClass="field-label"/>
                                        <TextField fx:id="txtDestino" promptText="Ej. 201"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="10">
                                    <Button text="Recargar" onAction="#recargar" styleClass="secondary-button"/>
                                    <Button text="Retirar" onAction="#retirar" styleClass="outline-button"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Transferir" onAction="#transferir" styleClass="primary-button"/>
                                </HBox>
                                <HBox styleClass="info-box">
                                    <Label wrapText="true" styleClass="info-text"
                                           text="Las transferencias entre usuarios de la plataforma no tienen comisión en esta simulación. Cada operación genera puntos de fidelización."/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- 3. Movimientos -->
                    <Tab text="Movimientos">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Tu actividad" styleClass="page-title"/>
                                <Label text="Solo se muestran tus propios movimientos." styleClass="muted-label"/>
                            </VBox>
                            <TableView fx:id="tablaTransacciones" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <placeholder><Label text="Todavía no hay movimientos." styleClass="muted-label"/></placeholder>
                                <columns>
                                    <TableColumn fx:id="colTxFecha" text="Fecha"/>
                                    <TableColumn fx:id="colTxTipo" text="Tipo"/>
                                    <TableColumn fx:id="colTxValor" text="Valor"/>
                                    <TableColumn fx:id="colTxOrigen" text="Origen"/>
                                    <TableColumn fx:id="colTxDestino" text="Destino"/>
                                    <TableColumn fx:id="colTxPuntos" text="Puntos"/>
                                    <TableColumn fx:id="colTxEstado" text="Estado"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- 4. Programar -->
                    <Tab text="Programar">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Movimientos automáticos" styleClass="page-title"/>
                                <Label text="Programa recargas, retiros o transferencias para una fecha futura."
                                       styleClass="muted-label"/>
                            </VBox>
                            <VBox spacing="8" styleClass="surface-card">
                                <FlowPane hgap="10" vgap="10" styleClass="form-row">
                                    <TextField fx:id="txtProgramadaId" promptText="Identificador (opcional)" prefWidth="190"/>
                                    <ComboBox fx:id="cmbWalletProgramada" promptText="Mi billetera origen" prefWidth="240"/>
                                    <TextField fx:id="txtProgramadaDestino" promptText="Destino (si es transferencia)" prefWidth="200"/>
                                    <TextField fx:id="txtProgramadaMonto" promptText="Monto" prefWidth="130"/>
                                    <TextField fx:id="txtProgramadaFecha" promptText="AAAA-MM-DDTHH:MM" prefWidth="180"/>
                                    <ChoiceBox fx:id="cmbProgramadaTipo" prefWidth="190"/>
                                    <ChoiceBox fx:id="cmbProgramadaFrecuencia" prefWidth="130"/>
                                    <Button text="Programar" onAction="#programarOperacion" styleClass="primary-button"/>
                                </FlowPane>
                                <HBox styleClass="info-box">
                                    <Label wrapText="true" styleClass="info-text"
                                           text="Formato de fecha: AAAA-MM-DDTHH:MM (ej. 2026-12-01T09:30). Las operaciones se procesan en orden de fecha mediante una cola de prioridad."/>
                                </HBox>
                            </VBox>
                            <TableView fx:id="tablaProgramadas" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <placeholder><Label text="No tienes operaciones programadas." styleClass="muted-label"/></placeholder>
                                <columns>
                                    <TableColumn fx:id="colProgFecha" text="Fecha"/>
                                    <TableColumn fx:id="colProgId" text="ID"/>
                                    <TableColumn fx:id="colProgTipo" text="Tipo"/>
                                    <TableColumn fx:id="colProgMonto" text="Monto"/>
                                    <TableColumn fx:id="colProgFrecuencia" text="Frecuencia"/>
                                    <TableColumn fx:id="colProgEstado" text="Estado"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- 5. Recompensas -->
                    <Tab text="Recompensas">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Puntos y cupones" styleClass="page-title"/>
                                <Label text="Canjea puntos por bonos y aplica el código a una de tus billeteras."
                                       styleClass="muted-label"/>
                            </VBox>
                            <SplitPane dividerPositions="0.52" VBox.vgrow="ALWAYS">
                                <VBox spacing="8">
                                    <Label text="Catálogo" styleClass="section-title"/>
                                    <TableView fx:id="tablaBeneficios" VBox.vgrow="ALWAYS">
                                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                        <placeholder><Label text="No hay recompensas disponibles." styleClass="muted-label"/></placeholder>
                                        <columns>
                                            <TableColumn fx:id="colBenNombre" text="Recompensa"/>
                                            <TableColumn fx:id="colBenPuntos" text="Puntos"/>
                                            <TableColumn fx:id="colBenBono" text="Abono"/>
                                        </columns>
                                    </TableView>
                                    <Button text="Canjear beneficio seleccionado" onAction="#canjearBeneficio"
                                            styleClass="primary-button" maxWidth="Infinity"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="Tus cupones" styleClass="section-title"/>
                                    <TableView fx:id="tablaCanjes" VBox.vgrow="ALWAYS">
                                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                        <placeholder><Label text="Aún no has canjeado cupones." styleClass="muted-label"/></placeholder>
                                        <columns>
                                            <TableColumn fx:id="colCanjeCodigo" text="Código"/>
                                            <TableColumn fx:id="colCanjeNombre" text="Beneficio"/>
                                            <TableColumn fx:id="colCanjeEstado" text="Estado"/>
                                            <TableColumn fx:id="colCanjeBono" text="Abono"/>
                                        </columns>
                                    </TableView>
                                    <Label text="Billetera que recibe el bono" styleClass="field-label"/>
                                    <ComboBox fx:id="cmbBilleteraCupon" promptText="Elige una billetera" maxWidth="Infinity"/>
                                    <HBox spacing="8">
                                        <TextField fx:id="txtCodigoCupon" promptText="Código RED-CANJE-..." HBox.hgrow="ALWAYS"/>
                                        <Button text="Aplicar cupón" onAction="#aplicarCupon" styleClass="secondary-button"/>
                                    </HBox>
                                </VBox>
                            </SplitPane>
                        </VBox>
                    </Tab>

                    <!-- 6. Mi información -->
                    <Tab text="Mi información">
                        <VBox spacing="14" styleClass="tab-content">
                            <VBox spacing="4">
                                <Label text="Mi perfil y notificaciones" styleClass="page-title"/>
                                <Label text="Consulta tu información, alertas y actividad de seguridad." styleClass="muted-label"/>
                            </VBox>
                            <GridPane hgap="18" vgap="12" styleClass="surface-card">
                                <Label text="Nombre" GridPane.rowIndex="0" styleClass="field-label"/>
                                <Label fx:id="lblPerfilNombre" text="" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Label text="Identificación" GridPane.rowIndex="1" styleClass="field-label"/>
                                <Label fx:id="lblPerfilId" text="" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label text="Correo" GridPane.rowIndex="2" styleClass="field-label"/>
                                <Label fx:id="lblPerfilCorreo" text="" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            </GridPane>
                            <Label text="Alertas recientes" styleClass="section-title"/>
                            <TableView fx:id="tablaAlertas" VBox.vgrow="ALWAYS">
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                <placeholder><Label text="Sin alertas por ahora." styleClass="muted-label"/></placeholder>
                                <columns>
                                    <TableColumn fx:id="colAlertaFecha" text="Fecha"/>
                                    <TableColumn fx:id="colAlertaTipo" text="Tipo"/>
                                    <TableColumn fx:id="colAlertaMensaje" text="Mensaje"/>
                                    <TableColumn fx:id="colAlertaAtendida" text="Atendida"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
