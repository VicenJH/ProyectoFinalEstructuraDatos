<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/fintech.css"
            fx:controller="co.edu.uniquindio.proyectofinal.Presentacion.ViewControllers.LoginViewController"
            styleClass="login-page">
    <center>
        <VBox alignment="CENTER" spacing="24" maxWidth="1080" styleClass="login-shell">
            <padding><Insets top="30" right="42" bottom="26" left="42"/></padding>

            <!-- Marca -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="NEXO" styleClass="brand-mark"/>
                <Label text="Tu dinero, bajo tu control." styleClass="login-title"/>
                <Label text="Plataforma académica de billeteras digitales y analítica financiera"
                       styleClass="login-subtitle"/>
            </VBox>

            <!-- Estructuras de datos usadas (útil para la sustentación) -->
            <HBox alignment="CENTER" spacing="8">
                <Label text="Tabla hash" styleClass="chip, chip-indigo"/>
                <Label text="Árbol AVL" styleClass="chip, chip-teal"/>
                <Label text="Cola de prioridad" styleClass="chip, chip-amber"/>
                <Label text="Pila LIFO" styleClass="chip, chip-rose"/>
                <Label text="Cola FIFO" styleClass="chip, chip-sky"/>
                <Label text="Grafo dirigido" styleClass="chip, chip-emerald"/>
                <Label text="Listas enlazadas" styleClass="chip, chip-violet"/>
            </HBox>

            <!-- Tres accesos -->
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="login-card, card-user">
                    <Label text="01 · USUARIO" styleClass="step-badge, badge-user"/>
                    <Label text="Entra a tu billetera" styleClass="card-title"/>
                    <Label text="Consulta tus saldos, mueve dinero, revisa tus movimientos y administra tus recompensas."
                           wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Cédula o identificación" styleClass="field-label"/>
                    <TextField fx:id="txtIdentificacion" promptText="Ej. U001" onAction="#ingresarUsuario"
                               styleClass="large-field"/>
                    <Button text="Entrar como usuario" onAction="#ingresarUsuario"
                            styleClass="primary-button" maxWidth="Infinity" defaultButton="false"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="login-card, card-admin">
                    <Label text="02 · ADMINISTRACIÓN" styleClass="step-badge, badge-admin"/>
                    <Label text="Centro de control" styleClass="card-title"/>
                    <Label text="Gestiona usuarios, billeteras, movimientos, recompensas, alertas, analítica y respaldos."
                           wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Clave de administrador" styleClass="field-label"/>
                    <PasswordField fx:id="txtClaveAdmin" promptText="Clave de acceso" onAction="#ingresarAdministrador"
                                   styleClass="large-field"/>
                    <Button text="Entrar como administrador" onAction="#ingresarAdministrador"
                            styleClass="secondary-button" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="login-card, card-test">
                    <Label text="03 · CALIDAD" styleClass="step-badge, badge-test"/>
                    <Label text="Monitor de pruebas" styleClass="card-title"/>
                    <Label text="Ejecuta la suite de regresión, observa el avance y consulta el tiempo de cada grupo de pruebas."
                           wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Pruebas aisladas · no alteran tus datos" styleClass="field-label"/>
                    <Button text="Abrir monitor de pruebas" onAction="#abrirMonitor"
                            styleClass="outline-button" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="8">
                <Label text="¿Aún no tienes cuenta?" styleClass="muted-label"/>
                <Button text="Crear cuenta nueva" onAction="#abrirRegistro" styleClass="outline-button"/>
            </HBox>

            <!-- Estado -->
            <HBox alignment="CENTER" spacing="8">
                <Label text="DATOS LOCALES Y PERSISTENTES" styleClass="status-dot"/>
                <Label text="·" styleClass="muted-label"/>
                <Label fx:id="lblEstadoDatos" text="Cargando datos del sistema..." styleClass="muted-label"/>
            </HBox>
            <Label text="Proyecto académico · Estructuras de datos · UniQuindío" styleClass="footer-label"/>
        </VBox>
    </center>
</BorderPane>
