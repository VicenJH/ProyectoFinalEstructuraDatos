<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.proyectofinal.Presentacion.Controladores.LoginViewController"
            styleClass="login-page">
    <center>
        <VBox alignment="CENTER" spacing="22" maxWidth="1040" styleClass="login-shell">
            <padding><Insets top="34" right="42" bottom="34" left="42"/></padding>
            <VBox alignment="CENTER" spacing="8">
                <Label text="NEXO" styleClass="brand-mark"/>
                <Label text="Tu dinero, bajo tu control." styleClass="login-title"/>
                <Label text="Plataforma académica de billeteras digitales y analítica financiera" styleClass="muted-label"/>
            </VBox>
            <HBox spacing="18" alignment="CENTER">
                <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="login-card">
                    <Label text="01 · USUARIO" styleClass="eyebrow"/>
                    <Label text="Entra a tu billetera" styleClass="card-title"/>
                    <Label text="Consulta tus saldos, mueve dinero, revisa tus movimientos y administra tus recompensas." wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Cédula o identificación" styleClass="field-label"/>
                    <TextField fx:id="txtIdentificacion" promptText="Ej. U001" styleClass="large-field"/>
                    <Button text="Entrar como usuario" onAction="#ingresarUsuario" styleClass="primary-button" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="login-card">
                    <Label text="02 · ADMINISTRACIÓN" styleClass="eyebrow"/>
                    <Label text="Centro de control" styleClass="card-title"/>
                    <Label text="Gestiona usuarios, billeteras, movimientos, recompensas, alertas, analítica y pruebas." wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Clave de administrador" styleClass="field-label"/>
                    <PasswordField fx:id="txtClaveAdmin" promptText="Clave de acceso" styleClass="large-field"/>
                    <Button text="Entrar como administrador" onAction="#ingresarAdministrador" styleClass="secondary-button" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="14" HBox.hgrow="ALWAYS" styleClass="login-card test-card">
                    <Label text="03 · CALIDAD" styleClass="eyebrow"/>
                    <Label text="Monitor de pruebas" styleClass="card-title"/>
                    <Label text="Ejecuta la suite de regresión, observa el avance y consulta el tiempo de cada grupo de pruebas." wrapText="true" styleClass="muted-label"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Pruebas aisladas · sin alterar tus datos" styleClass="field-label"/>
                    <Button text="Abrir monitor de pruebas" onAction="#abrirMonitor" styleClass="outline-button" maxWidth="Infinity"/>
                </VBox>
            </HBox>
            <HBox alignment="CENTER" spacing="8">
                <Label text="DATOS LOCALES Y PERSISTENTES" styleClass="status-dot"/>
                <Label text="·" styleClass="muted-label"/>
                <Label fx:id="lblEstadoDatos" text="Cargando datos del sistema..." styleClass="muted-label"/>
            </HBox>
            <Label text="Proyecto académico · Estructuras de datos · UniQuindío" styleClass="footer-label"/>
        </VBox>
    </center>
</BorderPane>
